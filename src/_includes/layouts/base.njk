<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ title }}</title>
    {%- if description %}
    <meta name="description" content="{{ description }}">

    <meta property="og:type" content="website">
    <meta property="og:locale" content="en_GB">
    <meta property="og:url" content="https://vocawaves.org{{ page.url }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:image" content="https://vocawaves.org{{ ogImage or '/assets/img/og.jpg' }}">
    <meta property="og:image:width" content="{{ ogImageWidth or 1200 }}">
    <meta property="og:image:height" content="{{ ogImageHeight or 630 }}">
    <meta property="og:image:alt" content="{{ ogImageAlt or 'Hatsune Miku on stage at ICon 2025' }}">

    <meta name="twitter:card" content="summary_large_image">
    {%- endif %}

    {%- if noindex %}
    <meta name="robots" content="noindex">
    {%- endif %}

    {%- if favicon %}
    <link rel="icon" href="{{ favicon }}">
    {%- endif %}

    <meta name="theme-color" content="{{ themeColor or '#8350d1' }}">
    <link rel="stylesheet" href="/assets/css/index.css">
    <noscript>
        <style>
            .to-top {
                visibility: visible;
                opacity: 1;
            }
        </style>
    </noscript>
    <style>
        .ie-warning {
            display: none;
        }

        _:-ms-fullscreen, :root body {
            overflow: hidden;
        }

        _:-ms-fullscreen, :root .ie-warning {
            display: block;
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            z-index: 2147483647;
            padding: 20vh 2rem 2rem;
            background: #212121;
            color: #fff;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        _:-ms-fullscreen, :root .ie-warning h1,
        _:-ms-fullscreen, :root .ie-warning p {
            max-width: 40rem;
            margin: 0 auto 1rem;
            font-family: Arial, sans-serif;
        }
    </style>
</head>

<body>
<div class="ie-warning" role="alert">
    <h1>This browser isn't supported</h1>
    <p>Please open vocawaves.org in a current version of Chrome, Edge, Firefox or Safari.</p>
</div>
{{ content | safe }}
</body>

</html>
